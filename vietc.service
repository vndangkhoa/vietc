[Unit]
Description=Viet+ Vietnamese IME Daemon (rootless)
PartOf=graphical-session.target
After=graphical-session.target
# IBus engine path (Ubuntu GNOME Wayland fix) needs no DISPLAY — it talks
# to ibus-daemon over D-Bus and covers native Wayland apps. The legacy
# rootless X11 path (XQueryKeymap+XTEST) still needs DISPLAY/XWayland.
# We use no ConditionEnvironment so the service starts on Wayland-native
# sessions too. The daemon itself probes for zwp_input_method_v2, then IBus,
# then X11, so it gracefully handles either environment.
# If your compositor does not import DISPLAY, run once:
#   systemctl --user import-environment DISPLAY WAYLAND_DISPLAY
# or drop an EnvironmentFile=/etc/default/vietc with the values.

[Service]
Type=simple
ExecStart=/usr/bin/vietc-daemon
Restart=on-failure
RestartSec=3
# Only kill the daemon on stop; the IBus it respawns (IbusRestartGuard) must
# survive so input works again after vietc exits.
KillMode=process

[Install]
WantedBy=graphical-session.target
