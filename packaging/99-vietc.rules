# Udev rule for Viet+ input method
# Allows logged-in desktop users (uaccess) and 'input' group members to access /dev/uinput and /dev/input/event*
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
SUBSYSTEM=="input", KERNEL=="event*", TAG+="uaccess", GROUP="input", MODE="0660"
